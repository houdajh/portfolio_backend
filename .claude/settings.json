{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(./mvnw -q clean compile)",
      "Bash(./mvnw compile:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Edit(**/application-prod.yml)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./mvnw -q -DskipTests compile",
            "timeout": 300
          }
        ]
      }
    ]
  }
}